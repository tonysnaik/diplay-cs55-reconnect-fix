*.apk
*.aab
*.apks
*.jar
*.dex
*.odex
*.zip
*.keystore
*.jks
*.p12
*.pk8

# apktool 工作树
decoded/
decode*/
verify_dec/
build/
dist/

# 原始日志与素材（含设备名、蓝牙 MAC、内网 IP、照片）
logs/
日志/
车机版本照片/
*.log
DiPlay-*.txt

# 临时工作目录
_work/
_tmp*/
*.orig
*.bak
*~

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc
